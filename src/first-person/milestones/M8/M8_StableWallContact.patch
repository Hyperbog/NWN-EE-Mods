+    // M8: world-space contact offset, never smooth ordinary view yaw or the eye anchor.
+    private static Vector3 _edgeHeld, _edgeAnchor;
+    private static IntPtr _edgeScene, _edgePlayer;
+    private static long _edgeTick, _edgeHardFallbacks, _edgeSmoothed;
+    private const float EdgeApproachSpeed = 1.8f; // metres per second
+    private const float EdgeReleaseSpeed = 0.8f;
+    private const float EdgeSafetySkin = 0.005f;
 
+    private static void ResetEdgeHistory()
+    {
+        _edgeHeld = _edgeAnchor = Vector3.Zero;
+        _edgeScene = _edgePlayer = IntPtr.Zero;
+        _edgeTick = 0;
+    }
+
+    // Check the actual near rectangle (plus a small skin), not the larger
+    // anticipatory M7 margin. A clear candidate can ease toward the full margin;
+    // a blocked candidate must never be accepted merely to make motion smooth.
+    private static bool EdgeCandidateClear(IntPtr scene, Vector3 anchor, Vector3 solved,
+        Vector3 candidate, Vector3 forward, Vector3 right, Vector3 up,
+        float near, float halfWidth, float halfHeight, IntPtr playerGob)
+    {
+        if (EdgeHit(scene, anchor, candidate, playerGob, out _) ||
+            EdgeHit(scene, solved, candidate, playerGob, out _)) return false;
+        for (int i = 0; i < 9; i++)
+        {
+            int x = i % 3 - 1, y = i / 3 - 1;
+            Vector3 ray = forward * near + right * (x * halfWidth) + up * (y * halfHeight);
+            float len = ray.Length();
+            if (!float.IsFinite(len) || len < 0.001f) return false;
+            if (EdgeHit(scene, candidate, candidate + ray * (1f + EdgeSafetySkin / len),
+                        playerGob, out _)) return false;
+        }
+        return true;
+    }
+
+    private static Vector3 StabilizeEdges(IntPtr scene, IntPtr player, Vector3 anchor,
+        Vector3 solved, Vector3 forward, Vector3 right, Vector3 up,
+        float near, float halfWidth, float halfHeight, IntPtr playerGob)
+    {
+        long now = Stopwatch.GetTimestamp();
+        float elapsed = _edgeTick > 0 ? (now - _edgeTick) / (float)Stopwatch.Frequency : 0f;
+        bool same = _edgeTick > 0 && scene == _edgeScene && player == _edgePlayer
+            && elapsed >= 0f && elapsed <= 0.15f
+            && Vector3.DistanceSquared(anchor, _edgeAnchor) <= MaxStableMoveSq;
+        Vector3 target = solved - anchor;
+        Vector3 chosen = target;
+        if (same)
+        {
+            Vector3 delta = target - _edgeHeld;
+            float length = delta.Length();
+            float speed = target.LengthSquared() < _edgeHeld.LengthSquared()
+                ? EdgeReleaseSpeed : EdgeApproachSpeed;
+            float step = speed * MathF.Min(elapsed, 0.05f);
+            Vector3 proposed = length <= step || length < 0.0001f
+                ? target : _edgeHeld + delta * (step / length);
+            if (proposed.LengthSquared() <= EdgeBudget * EdgeBudget + 0.00001f &&
+                EdgeCandidateClear(scene, anchor, solved, anchor + proposed, forward,
+                    right, up, near, halfWidth, halfHeight, playerGob))
+            {
+                chosen = proposed;
+                if (Vector3.DistanceSquared(chosen, target) > 0.000001f) _edgeSmoothed++;
+            }
+            else if (Vector3.DistanceSquared(proposed, target) > 0.000001f)
+            {
+                // Search toward the original M7 solution for a verified clear
+                // intermediate, without assuming intermediate safety is monotone.
+                // Start with the least movement away from the proposed offset.
+                bool found = false;
+                for (int i = 1; i <= 3; i++)
+                {
+                    Vector3 trial = Vector3.Lerp(proposed, target, i * 0.25f);
+                    if (trial.LengthSquared() > EdgeBudget * EdgeBudget + 0.00001f ||
+                        !EdgeCandidateClear(scene, anchor, solved, anchor + trial, forward,
+                            right, up, near, halfWidth, halfHeight, playerGob)) continue;
+                    chosen = trial; _edgeSmoothed++; found = true; break;
+                }
+                if (!found) _edgeHardFallbacks++;
+                // If none are clear, preserve the exact original M7 response.
+            }
+        }
+        _edgeScene = scene; _edgePlayer = player; _edgeAnchor = anchor;
+        _edgeTick = now; _edgeHeld = chosen;
+        return anchor + chosen;
+    }
