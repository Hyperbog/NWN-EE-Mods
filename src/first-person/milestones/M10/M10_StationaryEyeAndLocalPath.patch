+    private static float M10StallWeight(IntPtr player, float dt, out Vector3 actor)
+    {
+        actor = new CNWCObject(player).Position;
+        var creature = new CNWCCreature(player);
+        IntPtr mod = Module();
+        IntPtr area = mod == IntPtr.Zero ? IntPtr.Zero : new CNWCModule(mod).CurrentArea.Ptr;
+        int anim = new CNWCObject(player).Animation;
+        long now = Environment.TickCount64;
+        bool loco = anim is 2 or 3 or 4 or 0x4e or 0x4f or >= 0x54 and <= 0x57;
+        bool valid = Mode == 2 && !GateUp && !NpcDialogActive && !FreeCameraService.Active &&
+            area != IntPtr.Zero && loco && (creature.Driving == 1 || CameraDriveService.Held) &&
+            !JumpPositionService.AirborneFor(player) &&
+            float.IsFinite(actor.X) && float.IsFinite(actor.Y) && float.IsFinite(actor.Z);
+        if (!valid || player != _m10Player || area != _m10Area ||
+            now - _m10LastSample > 250 || now < _m10LastSample)
+        {
+            _m10Player = player; _m10Area = area;
+            _m10ProgressOrigin = actor; _m10ProgressAt = _m10LastSample = now;
+            _m10Weight = 0f; _m10Stalled = false;
+            return 0f;
+        }
+        _m10LastSample = now;
+        Vector3 delta = actor - _m10ProgressOrigin;
+        if (delta.X * delta.X + delta.Y * delta.Y >= 0.0004f || MathF.Abs(delta.Z) > 0.05f)
+        { _m10ProgressOrigin = actor; _m10ProgressAt = now; }
+        bool stalled = now - _m10ProgressAt >= 120;
+        if (stalled != _m10Stalled)
+        {
+            _m10Stalled = stalled;
+            _log?.Info($"[m10camera] stationary locomotion={(stalled ? 1 : 0)} anim={anim} drive={creature.Driving} held={(CameraDriveService.Held ? 1 : 0)}");
+        }
+        float step = Math.Clamp(dt, 0f, 0.05f) * 10f;
+        _m10Weight = Math.Clamp(_m10Weight + (stalled ? step : -step), 0f, 1f);
+        return _m10Weight;
+    }
