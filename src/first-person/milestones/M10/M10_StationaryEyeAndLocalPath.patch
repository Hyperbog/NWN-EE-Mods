+    // The native remaining-path loop uses Vector* (12-byte stride), the cursor,
+    // count and DesiredPos. Shorten only a one-point, client-predicted drive to
+    // its already verified stationary position; let WalkUpdateLocation finish it.
+    // Never mutate array metadata, free memory, set animation IDs or server paths.
+    private static bool M10ShortenLocalPath(CNWCCreature c, Vector3 safe)
+    {
+        Vector3 actual = new CNWCObject(c.Ptr).Position;
+        IntPtr path = c.Waypoints, cursor = c.WaypointCursor;
+        ushort count = c.WaypointCount;
+        int source = c.PathFromServer;
+        _log?.Info($"[m10path] release source={source} count={count} cursorAtStart={(path == cursor ? 1 : 0)} drive={c.Driving} correctionMs={c.CorrectionMs}");
+        if (source != 0 || count != 1 || path == IntPtr.Zero || cursor != path ||
+            c.Driving != 1 || c.CorrectionMs != 0 || JumpPositionService.AirborneFor(c.Ptr) ||
+            !M10Finite(safe) || !M10Finite(actual) || Vector3.DistanceSquared(safe, actual) > 0.0004f)
+            return false;
+        Vector3 endpoint = *(Vector3*)path;
+        float distance = Vector3.DistanceSquared(endpoint, safe);
+        if (!M10Finite(endpoint) || distance < 0.000001f || distance > 16f) return false;
+        *(Vector3*)path = safe;
+        _log?.Info("[m10path] shortened one local predicted waypoint to the stationary safe position");
+        return true;
+    }
+
+    private static bool M10Finite(Vector3 v) =>
+        float.IsFinite(v.X) && float.IsFinite(v.Y) && float.IsFinite(v.Z);
