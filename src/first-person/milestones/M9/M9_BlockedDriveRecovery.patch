     // M6: continuous refusals for this player/area, independent of the bounded diagnostic log.
     private static IntPtr _m6Creature, _m6Area;
     private static long _m6FirstRefusal, _m6LastRefusal;
     private static int _m6Refusals;
 
     internal static bool M6PersistentRefusal(IntPtr creature, IntPtr area, long releasedAt, long now)
         => _m6Creature == creature && _m6Area == area && _m6Refusals >= 2
             && _m6LastRefusal >= releasedAt && now - _m6LastRefusal <= 100
             && now - Math.Max(_m6FirstRefusal, releasedAt) >= 150;
 
+    // Early stop only for repeated, recent refusals of this creature and area.
+    internal static bool M9RecentRefusal(IntPtr creature, IntPtr area, long now)
+        => _m6Creature == creature && _m6Area == area && _m6Refusals >= 2
+            && now - _m6LastRefusal >= 0 && now - _m6LastRefusal <= 100;
+
     private static void M6RecordRefusal(IntPtr creature, IntPtr area)
     {
         long now = Environment.TickCount64;
         if (_m6Creature != creature || _m6Area != area || now - _m6LastRefusal > 100)
         {
             _m6Creature = creature; _m6Area = area;
             _m6FirstRefusal = now; _m6Refusals = 0;
         }
         _m6LastRefusal = now;
         if (_m6Refusals < int.MaxValue) _m6Refusals++;
     }
 
